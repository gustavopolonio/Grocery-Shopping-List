generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  username    String
  avatarUrl   String?
  planId      String
  createdAt   DateTime @default(now())

  plan              Plan                @relation(fields: [planId], references: [id])
  list              List[]
  listMember        ListMember[]
  userCustomProduct UserCustomProduct[]
  listItem          ListItem[]
  invitesCreated    ListInvite[]        @relation("CreatedByProfile")
  invitesUsed       ListInvite[]        @relation("UsedByProfile")
  listInvite        ListInvite[]

  @@map("profiles")
}

model Plan {
  id                     String   @id @default(uuid())
  name                   PlanName @unique
  maxListsUserCanBe      Int?
  maxItemsPerList        Int?
  maxCustomItemsPerUser  Int?
  maxUsersPerList        Int?
  whisperMinutesPerMonth Int?

  profile Profile[]

  @@map("plans")
}

model List {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      Profile      @relation(fields: [ownerId], references: [id])
  listMember ListMember[]
  listItem   ListItem[]
  listInvite ListInvite[]

  @@map("lists")
}

model ListMember {
  listId    String
  profileId String
  role      ListRole @default(MEMBER)
  createdAt DateTime @default(now())

  list    List    @relation(fields: [listId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id])

  @@id([listId, profileId])
  @@map("listMembers")
}

model Category {
  id          String   @id @default(uuid())
  icon        String
  defaultName String   @unique
  createdAt   DateTime @default(now())

  categoryTranslation       CategoryTranslation[]
  productCategory           ProductCategory[]
  userCustomProductCategory UserCustomProductCategory[]

  @@map("categories")
}

model CategoryTranslation {
  name       String
  language   Language
  categoryId String
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id])

  @@id([categoryId, language])
  @@map("categoryTranslations")
}

model Product {
  id          String   @id @default(uuid())
  icon        String
  defaultName String   @unique
  createdAt   DateTime @default(now())

  productTranslation        ProductTranslation[]
  listItem                  ListItem[]
  productCategory           ProductCategory[]
  userCustomProductCategory UserCustomProductCategory[]

  @@map("products")
}

model ProductTranslation {
  name      String
  language  Language
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, language])
  @@map("productTranslations")
}

model UserCustomProduct {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  createdBy String
  createdAt DateTime @default(now())

  profile                   Profile                     @relation(fields: [createdBy], references: [id])
  listItem                  ListItem[]
  userCustomProductCategory UserCustomProductCategory[]

  @@map("userCustomProducts")
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model UserCustomProductCategory {
  userCustomProductId String
  categoryId          String
  createdAt           DateTime @default(now())

  userCustomProduct UserCustomProduct @relation(fields: [userCustomProductId], references: [id], onDelete: Cascade)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  Product           Product?          @relation(fields: [productId], references: [id])
  productId         String?

  @@id([userCustomProductId, categoryId])
}

model ListItem {
  id              String   @id @default(uuid())
  listId          String
  addedBy         String
  productId       String?
  customProductId String?
  quantity        Int      @default(1)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  list          List               @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedByUser   Profile            @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  product       Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  customProduct UserCustomProduct? @relation(fields: [customProductId], references: [id], onDelete: Cascade)

  @@map("listItems")
}

model ListInvite {
  id        String    @id @default(uuid())
  listId    String
  createdBy String
  usedBy    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  list          List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdByUser Profile  @relation("CreatedByProfile", fields: [createdBy], references: [id], onDelete: Cascade)
  usedByUser    Profile  @relation("UsedByProfile", fields: [usedBy], references: [id], onDelete: Cascade)
  profile       Profile? @relation(fields: [profileId], references: [id])
  profileId     String?

  @@map("listInvites")
}

enum PlanName {
  FREE
  PRO
}

enum ListRole {
  OWNER
  MEMBER
}

enum Language {
  ptBR
  enUS
}
